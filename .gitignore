# Disc images and anything extracted from them. Never commit game data.
*.bin
*.cue
*.img
*.iso
*.nds
*.raw
HBD1PS1D.*
SLPM_*
SLUS*
SYSTEM.CNF

# Decoded corpora and bulk dumps
*.corpus
*.dump
corpus/
dumps/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
build/

# docs/ is ignored wholesale except the published screenshots, which are the only
# binary assets this repo carries and are checked into docs/images/.
docs/*
!docs/images/
docs/images/*
!docs/images/*.png
